{
  "name": "@fleetscope/simulator",
  "version": "0.0.0",
  "private": true,
  "description": "Simulator: posts calibrated synthetic sessions (source=sim) to the Fleetscope API",
  "type": "module",
  "scripts": {
    "sim": "node --env-file-if-exists=../../.env --import tsx src/cli.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fleetscope/db": "workspace:*",
    "@fleetscope/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15"
  }
}
