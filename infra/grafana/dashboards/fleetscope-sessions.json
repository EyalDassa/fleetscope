  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Sessions ↗",
      "description": "Every session that ran at any time in the range (it started in it, ended in it, or was still running), newest start first, at most 1000 rows (the footer counts the rows shown). That is a superset of the sessions behind the numbers of the Overview: those count by start or by end time. Status: healthy, degraded (success with a failed action or an issue), failed (failed, timeout or crashed), blocked, running, interrupted (Ctrl+C, not a failure). Cause is the code and the reason of the session. Peak memory is the container's. Est. cost: Browser-hours × $0.10 per browser-hour (Browserbase's published price, from the `pricing` table). An estimate, not a bill. Session shows the first 8 characters of the id. Click a status or a session to open it.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 22
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "fleetscope-clickhouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "fleetscope-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "-- Every session that ran at any time in the range (started in it, ended in it, or still running), newest\n-- start first, at most 1000 rows. session-facts holds exactly those sessions, so no further time filter here:\n-- the list contains every session behind a number of the Overview.\n-- display_status: healthy | degraded (success with a failed action or an issue) | failed (failed, timeout, crashed)\n--   | blocked | running | interrupted (Ctrl+C, not a failure). Cause = first issue kind, else error_code of the\n--   first failed action, else the status, shown as \"cause: reason\"; the \"cause\" box (set by the Top failure\n--   causes links) filters on the code. Est. cost: pricing_current x browser-hours (running ones count until now).\n-- Peak memory: the sessions come from sessions FINAL, so session-facts is read once.\n-- from_ms / to_ms (hidden) set the time range of the Session detail link: start - 5 s ... end (or now) + 5 s.\nWITH facts AS\n(\n    WITH\n        picked AS\n        (\n            SELECT *\n            FROM sessions FINAL\n            WHERE engine IN (${engine:singlequote})\n              AND source IN (${source:singlequote})\n              AND started_at >= $__fromTime - INTERVAL 1 DAY\n              AND started_at <= $__toTime\n              AND (ended_at IS NULL OR ended_at >= $__fromTime)\n        ),\n        issue_facts AS\n        (\n            SELECT session_id, count() AS issue_count, toString(argMin(kind, ts)) AS first_issue\n            FROM issues\n            WHERE session_id IN (SELECT session_id FROM picked)\n              AND ts >= (SELECT min(started_at) FROM picked)\n              AND engine IN (${engine:singlequote})\n              AND source IN (${source:singlequote})\n            GROUP BY session_id\n        ),\n        action_facts AS\n        (\n            SELECT\n                session_id,\n                count() AS actions,\n                countIf(NOT ok) AS failed_actions,\n                ifNull(argMinIf(error_code, seq, NOT ok), '') AS first_failed_code\n            FROM actions\n            WHERE session_id IN (SELECT session_id FROM picked)\n              AND ts >= (SELECT min(started_at) FROM picked)\n              AND engine IN (${engine:singlequote})\n              AND source IN (${source:singlequote})\n            GROUP BY session_id\n        )\n    SELECT\n        p.session_id AS session_id,\n        p.agent_id AS agent_id,\n        p.source AS source,\n        p.engine AS engine,\n        p.engine_version AS engine_version,\n        p.provider AS provider,\n        p.scenario AS scenario,\n        p.started_at AS started_at,\n        p.ended_at AS ended_at,\n        p.status AS status,\n        p.reason AS reason,\n        p.duration_ms AS duration_ms,\n        p.startup_ms + p.connect_ms AS time_to_browser_ms,\n        (p.status = 'failed' AND ifNull(p.reason, '') = 'interrupted') AS is_interrupted,\n        a.actions AS actions,\n        a.failed_actions AS failed_actions,\n        i.issue_count AS issue_count,\n        multiIf(\n            p.status = 'running', 'running',\n            is_interrupted, 'interrupted',\n            p.status = 'success' AND a.failed_actions = 0 AND i.issue_count = 0, 'healthy',\n            p.status = 'success', 'degraded',\n            p.status = 'blocked', 'blocked',\n            'failed') AS display_status,\n        if(p.status NOT IN ('running', 'success') AND NOT is_interrupted,\n            multiIf(i.first_issue != '', i.first_issue, a.first_failed_code != '', a.first_failed_code, p.status),\n            NULL) AS cause,\n        if(cause IS NULL, NULL,\n            multiIf(i.first_issue != '', 'issue', a.first_failed_code != '', 'action', 'status')) AS cause_from,\n        (toUInt64(p.startup_ms) + p.connect_ms\n            + ifNull(p.duration_ms, dateDiff('millisecond', p.started_at, now64(3)))) / 3.6e6 AS browser_hours,\n        if(price.provider = '', NULL, browser_hours * price.usd_per_browser_hour) AS est_cost_usd\n    FROM picked AS p\n    LEFT JOIN issue_facts AS i ON i.session_id = p.session_id\n    LEFT JOIN action_facts AS a ON a.session_id = p.session_id\n    LEFT JOIN pricing_current AS price ON price.engine = p.engine AND price.provider = p.provider\n),\n    peaks AS\n    (\n        SELECT session_id AS peak_session_id, maxOrNull(mem_mb) AS peak_mib\n        FROM resource_samples\n        WHERE origin = 'container'\n          AND ts >= (SELECT min(started_at) FROM sessions FINAL WHERE started_at <= $__toTime AND (ended_at IS NULL OR ended_at >= $__fromTime) AND engine IN (${engine:singlequote}) AND source IN (${source:singlequote}))\n          AND session_id IN (SELECT session_id FROM sessions FINAL WHERE started_at <= $__toTime AND (ended_at IS NULL OR ended_at >= $__fromTime) AND engine IN (${engine:singlequote}) AND source IN (${source:singlequote}))\n        GROUP BY peak_session_id\n    )\nSELECT\n    f.display_status AS status,\n    if(match(f.session_id, '^[0-9a-f]{8}-[0-9a-f]{4}-'), substring(f.session_id, 1, 8), f.session_id) AS session,\n    f.started_at AS started,\n    f.source AS source,\n    f.engine AS engine,\n    f.scenario AS scenario,\n    f.duration_ms AS duration_ms,\n    if(f.cause IS NULL, NULL, if(ifNull(f.reason, '') = '', f.cause, concat(f.cause, ': ', f.reason))) AS cause,\n    f.time_to_browser_ms AS time_to_browser_ms,\n    f.actions AS actions,\n    f.failed_actions AS failed_actions,\n    p.peak_mib AS peak_memory_mib,\n    f.est_cost_usd AS estimated_cost_usd,\n    f.engine_version AS version,\n    f.agent_id AS agent,\n    f.session_id AS session_id,\n    toUnixTimestamp64Milli(f.started_at) - 5000 AS from_ms,\n    toUnixTimestamp64Milli(coalesce(f.ended_at, now64(3))) + 5000 AS to_ms\nFROM facts AS f\nLEFT JOIN peaks AS p ON p.peak_session_id = f.session_id\nWHERE $__conditionalAll(f.display_status IN (${status:singlequote}), $status)\n  AND $__conditionalAll(f.agent_id IN (${agent:singlequote}), $agent)\n  AND $__conditionalAll(f.scenario IN (${scenario:singlequote}), $scenario)\n  AND $__conditionalAll(f.cause = decodeURLComponent('${cause:percentencode}'), $cause)\nORDER BY f.started_at DESC\nLIMIT 1000\n",
          "refId": "A",
          "pluginVersion": "4.23.2"
        }
      ],
