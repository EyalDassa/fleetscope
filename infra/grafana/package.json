{
  "name": "@fleetscope/grafana-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Grafana tooling: push the data source and dashboards to a Grafana, check the dashboard JSON against ClickHouse",
  "type": "module",
  "scripts": {
    "push": "tsx --env-file-if-exists=../../.env src/cli/push.ts",
    "check": "tsx --env-file-if-exists=../../.env src/cli/check.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15"
  }
}
