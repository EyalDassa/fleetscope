{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "biome.json"],
  "globalPassThroughEnv": [
    "CLICKHOUSE_URL",
    "CLICKHOUSE_USER",
    "CLICKHOUSE_PASSWORD",
    "CLICKHOUSE_DATABASE",
    "API_PORT",
    "API_HOST",
    "LOG_LEVEL",
    "INGEST_BUFFER_CAPACITY",
    "FLEETSCOPE_API_URL",
    "DEMO_SITE_URL",
    "DEMO_SITE_BROWSER_URL",
    "DEMO_SITE_UPSTREAM",
    "DEMO_SITE_PORT",
    "DEMO_SITE_HOST",
    "FLEET_BROWSER_IMAGE",
    "DOCKER_HOST",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "//#lint:root": {
      "inputs": [
        "**/*.{json,jsonc,js,mjs,cjs,ts,tsx,mts,cts,css}",
        "!apps/**",
        "!packages/**",
        "!design/**",
        "!.claude/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/playwright-report/**",
        "!**/test-results/**"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:integration": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
