# dependencies
node_modules/

# build output and caches
.turbo/
dist/
out/
build/
coverage/
*.tsbuildinfo

# environment: every .env* file is ignored, only the template is committed
.env*
!.env.example

# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# local data and logs
*.log
infra/.data/
# Runtime data the apps write next to their working directory, e.g. the API's dead-letter folder
# apps/api/.data/deadletter (INGEST_DEADLETTER_DIR). The pattern matches at any depth.
.data/

# Node falls back to a folder literally named "undefined" (undefined/temp) as its temp dir when
# TEMP/TMP/SystemRoot are unset (stripped env on Windows). tsx then writes its cache there.
**/undefined/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Runner pause state for public sites (--state-file)
.fleet-state.json
