# Copy to .env (gitignored) and adjust. These defaults work with `pnpm infra:up`.
# Never commit real secrets. Production values live in the hosting provider / CI secrets.

# --- ClickHouse -------------------------------------------------------------
# HTTP interface (the official image exposes 8123 for HTTP, 9000 for the native protocol).
CLICKHOUSE_URL=http://localhost:8123
# Recent ClickHouse images disable network access for the passwordless `default` user
# when none of CLICKHOUSE_USER / CLICKHOUSE_PASSWORD is set, so we create our own user.
# docker-compose passes these to the container, the apps use them to connect.
CLICKHOUSE_USER=fleetscope
CLICKHOUSE_PASSWORD=fleetscope_dev_password
CLICKHOUSE_DATABASE=fleetscope

# --- Grafana (the dashboards, see infra/grafana/README.md) -------------------
# The dashboards are Grafana, not a Next.js app. Locally Grafana runs in docker-compose; in
# production it is Grafana Cloud (free tier). Both read ClickHouse with a READ-ONLY user.
#
# The read-only user Grafana connects as. Create it once after `pnpm db:migrate` with
# `pnpm db:grafana-user`. Never give Grafana the admin CLICKHOUSE_USER above.
# Avoid "$" in the password: Grafana expands $NAME in its provisioning files.
CLICKHOUSE_GRAFANA_USER=grafana_ro
CLICKHOUSE_GRAFANA_PASSWORD=grafana_ro_dev_password
# Local Grafana: http://127.0.0.1:${GRAFANA_PORT}. 3001 and not 3000, because 3000 is often taken.
GRAFANA_PORT=3001
# Password of the local Grafana "admin" user. Visitors without a login are Viewers.
GRAFANA_ADMIN_PASSWORD=fleetscope_dev_admin
# Only for `pnpm grafana:push` (uploads the data source and dashboards to a Grafana, normally
# Grafana Cloud). Use a service account token with the Admin role: Grafana > Administration >
# Users and access > Service accounts. Keep the token out of git; in CI it is a secret.
# GRAFANA_URL=https://your-stack.grafana.net
# GRAFANA_TOKEN=
# The ClickHouse URL as GRAFANA sees it, if that differs from CLICKHOUSE_URL (which is how your
# machine sees it). Example for ClickHouse Cloud: https://abc123.eu-central-1.aws.clickhouse.cloud:8443
# Without this, `grafana:push` falls back to CLICKHOUSE_URL.
# GRAFANA_CLICKHOUSE_URL=
# `grafana:push` also sets CLICKHOUSE_DATABASE, CLICKHOUSE_GRAFANA_USER and
# CLICKHOUSE_GRAFANA_PASSWORD on the data source, and writes FLEETSCOPE_API_URL (defined further
# down, in the fleet runner section) into the session dashboard's `api_url` variable, which builds the
# "Open timeline in Perfetto" link. That link is opened by the viewer's browser, not by Grafana, so
# http://localhost:4000 is right while the API runs on your laptop and you open Grafana Cloud on it.
# For anyone else, use the API's public URL. A push to a remote Grafana warns when the variable is
# unset (the dashboards then keep their committed localhost address) or points at localhost.
# A localhost CLICKHOUSE_URL is different: Grafana's server queries ClickHouse, so a push to a remote
# Grafana refuses it.

# --- API --------------------------------------------------------------------
API_PORT=4000
# Bind address. 127.0.0.1 locally; set 0.0.0.0 when deploying in a container.
API_HOST=127.0.0.1
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Max events the ingest buffer holds before POST /v1/events answers 503 + Retry-After.
INGEST_BUFFER_CAPACITY=50000
# Where the API writes a batch that ClickHouse keeps refusing (a data error, not an outage), so a
# poison batch is kept for inspection instead of blocking the buffer. Relative paths start at the
# API's working directory (apps/api when started through pnpm). The folder is gitignored (.data/).
# INGEST_DEADLETTER_DIR=./.data/deadletter

# --- Fleet runner, demo site and browser containers (M1) ---------------------
# Where the collector (inside the fleet runner) sends events: the API above.
FLEETSCOPE_API_URL=http://localhost:4000
# The site the browsers visit. Inside every browser container the same URL works, because the image
# forwards its own localhost:3100 to the host (infra/browsers/README.md). That keeps the page in a
# secure context, which APIs such as crypto.subtle need.
DEMO_SITE_URL=http://localhost:3100
# The URL the scenarios browse inside the container (normally the same localhost URL, via the forwarder).
DEMO_SITE_BROWSER_URL=http://localhost:3100
DEMO_SITE_PORT=3100
# To use another port, change it in FOUR places: DEMO_SITE_PORT, DEMO_SITE_URL, DEMO_SITE_BROWSER_URL
# and DEMO_SITE_UPSTREAM (below). The forwarder in the browser image listens on the same port number
# as its upstream, so the port in DEMO_SITE_BROWSER_URL must equal the one in DEMO_SITE_UPSTREAM.
# DEMO_SITE_UPSTREAM=host.docker.internal:3100
# 0.0.0.0 = reachable from the browser containers. On Linux (and CI) host.docker.internal is the
# Docker bridge address, so a loopback-only listener would not be reachable. It also means the LAN
# can reach the site; it holds no real data, but there is an unauthenticated /admin/chaos endpoint.
DEMO_SITE_HOST=0.0.0.0
# Browser image the runner starts, one container per session. Build it with `pnpm browsers:build`.
# The version in the tag must equal the Playwright version pinned in the runner and collector
# (CI checks this: .github/scripts/check-playwright-version.sh).
FLEET_BROWSER_IMAGE=fleetscope/playwright-chromium:1.64.1
# Docker API address. Leave unset: dockerode finds the Windows named pipe or /var/run/docker.sock.
# Only set it for a remote or non-default daemon, e.g. tcp://127.0.0.1:2375 or npipe:////./pipe/docker_engine.
# DOCKER_HOST=
