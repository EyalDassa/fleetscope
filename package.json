{
  "name": "fleetscope",
  "private": true,
  "version": "0.0.0",
  "description": "Observability for AI browser fleets",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@fleetscope/api --filter=@fleetscope/demo-site",
    "build": "turbo run build",
    "lint": "turbo run lint //#lint:root",
    "lint:root": "biome check --config-path=biome.root.json .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "biome check --write .",
    "infra:up": "docker compose --project-directory . -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --project-directory . -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @fleetscope/db migrate",
    "db:seed": "pnpm --filter @fleetscope/db seed",
    "db:grafana-user": "pnpm --filter @fleetscope/db grafana-user",
    "db:backfill-rollups": "pnpm --filter @fleetscope/db backfill-rollups",
    "grafana:push": "pnpm --filter @fleetscope/grafana-tools push",
    "grafana:check": "pnpm --filter @fleetscope/grafana-tools check",
    "grafana:reload": "pnpm --filter @fleetscope/grafana-tools reload",
    "fleet": "pnpm --filter @fleetscope/fleet-runner fleet",
    "browsers:build": "docker build -f infra/browsers/chromium/Dockerfile -t fleetscope/playwright-chromium:1.64.1-2 infra/browsers && docker build -f infra/browsers/forwarder/Dockerfile -t fleetscope/forwarder:1-1 infra/browsers",
    "browsers:pull": "docker pull chromedp/headless-shell:156.0.8078.48@sha256:3da74b0945e4f80f00f0310bcda9f76cee283539ebd200a053a7bebf3de89423 && docker pull lightpanda/browser:1.0.2@sha256:5d1d724c476957d8c2f8393a51fd089477523b0e5aa9c783c48688785d934fb9",
    "sim": "pnpm --filter @fleetscope/simulator sim"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
